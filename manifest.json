{
  "manifest_version": 3,
  "name": "MakerWorld Print Cost Calculator",
  "version": "2.0.0",
  "description": "Calculate 3D print cost directly on MakerWorld model pages.",
  "permissions": ["storage"],
  "host_permissions": ["https://makerworld.com/*", "https://*.makerworld.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MakerWorld Cost"
  },
  "content_scripts": [
    {
      "matches": ["https://makerworld.com/*", "https://*.makerworld.com/*"],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
